@startuml maquina_estados_partida
title Diagrama de Máquina de Estados — Partida

skinparam dpi 150
skinparam shadowing false
hide empty description
skinparam ArrowColor #58595B
skinparam state {
  BackgroundColor #EAF4EE
  BorderColor #6FAE8C
  StartColor #58595B
  EndColor #58595B
}
skinparam state<<pad>> {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
hide stereotype

[*] --> Preparacao : / gerarLinkConvite()

state "Em preparação" as Preparacao {
  state "Inscrições abertas" as Abertas
  state "Lotada" as Lotada
  state "Times sorteados" as Sorteados
  state "espaco" as Pad <<pad>>

  Abertas : inscrever(jogador) [antes da dataHora e não é a última vaga]\n    / cria Inscricao
  Abertas : cancelarInscricao(inscricao) [antes da dataHora]\n    / se era titular, promoverReserva()

  Sorteados : entry / encerra as inscrições (RN05)
  Sorteados : sortearTimes() / redistribui os times, mantendo o valor (RN03)
  Sorteados : cancelarInscricao(inscricao) [antes da dataHora]\n    / mantém o Pagamento (RN04); se era titular, promoverReserva()

  [*] --> Abertas
  Abertas --> Sorteados : sortearTimes()\n[titulares >= 2]\n/ calcularValorPorJogador()
  Abertas -right-> Lotada : inscrever(jogador)\n[antes da dataHora e é a última vaga]\n/ cria Inscricao
  Lotada -left-> Abertas : cancelarInscricao(inscricao)\n[antes da dataHora]\n/ se era titular, promoverReserva()
  Lotada -[hidden]right-> Pad
  Lotada --> Sorteados : sortearTimes()\n/ calcularValorPorJogador()
}

state "Encerrada" as Encerrada
state "Cancelada" as Cancelada

Sorteados --> Encerrada : encerrar()\n[dataHora já passou]
Preparacao --> Cancelada : cancelar()\n/ cancela os pagamentos não confirmados (RN08)

Encerrada --> [*]
Cancelada --> [*]

@enduml
